# Playwright Bot Tests - Environment Variables
# Copy this file to .env and fill in your values

# Test Email Account (receives bot confirmation emails)
TEST_EMAIL=your-test-email@zohomail.com
TEST_EMAIL_PASSWORD=your-app-password

# IMAP Configuration (for reading emails)
IMAP_USER=your-test-email@zohomail.com
IMAP_PASSWORD=your-app-password
IMAP_HOST=imap.zoho.com
IMAP_PORT=993

# SMTP Configuration (for sending failure notifications)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true

# Notification recipient (receives test failure alerts)
NOTIFY_ON_FAILURE=your-notification-email@example.com

# Skip Email Verification
# Set to true to skip IMAP email checking and use mock responses
# Recommended for CI and local development due to IMAP connection unreliability
# Set to false if you want to verify actual email receipts
SKIP_EMAIL_VERIFICATION=true
